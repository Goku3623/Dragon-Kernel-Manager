<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gaming_notif_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Top Gaming HUD Header Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_hud_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="⚡ DRAGON KERNEL // TELEMETRY HUD"
            android:textColor="#FF2A4B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_hud_active_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gaming_notif_badge"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="GAMING • 120 FPS"
            android:textColor="#00E5FF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6-Line Real-Time Battery & Power Telemetry Block (matching screenshot) -->
    <TextView
        android:id="@+id/tv_notif_line1_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="100% • 615 mA (2.7 W) • 35°C"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_notif_line2_drain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:text="Active: 0.0%/h • Idle: 0.0%/h"
        android:textColor="#E2E8F0"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/tv_notif_line3_screen_on"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:text="Screen On: 54s • 0.0% (7 mAh)"
        android:textColor="#E2E8F0"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/tv_notif_line4_screen_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:text="Screen Off: 0s • 0.0% (0 mAh)"
        android:textColor="#CBD5E1"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/tv_notif_line5_deep_sleep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:text="Deep sleep: 0s • 0.0%"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_notif_line6_awake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:text="Awake: 0s • 100.0%"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- Gaming Action Bar inside Notification Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_expanded_change_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_gaming_notif_btn"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="⚡ CHANGE BATTERY PROFILE"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_expanded_cycle_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gaming_notif_badge"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="🔄 CYCLE"
            android:textColor="#00E5FF"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
